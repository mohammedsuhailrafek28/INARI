      "css": ".ds-landing{display:inline-flex;align-items:center;min-height:24px;background:#ff6040;color:#0c0c0b;border-radius:6px;padding:14px 22px;font:650 15px \"Segoe UI\",sans-serif;text-decoration:none;transition:background .18s}.ds-landing:hover{background:#ff8065}.ds-landing:focus-visible{outline:2px solid #ff947e;outline-offset:4px}"
    },
    {
      "name": "Ledger field",
      "kind": "input",
      "description": "Visible label and native numeric input; ledger form treatment.",
      "html": "<label class=\"ds-label\">Monthly contribution<input class=\"ds-field\" type=\"number\" placeholder=\"Amount in INR\"></label>",
      "css": ".ds-label{display:grid;gap:8px;color:var(--wv-text,#f1eee6);font:14px \"Segoe UI\",sans-serif}.ds-field{background:var(--wv-surface,#161615);color:var(--wv-text,#f1eee6);border:1px solid var(--wv-border,#373733);border-radius:6px;padding:10px 8px;min-height:22px;font:14px \"Segoe UI\",sans-serif}.ds-field::placeholder{color:#aaa79f}.ds-field:focus-visible{outline:2px solid #ff947e;outline-offset:4px}"
    },
    {
      "name": "Application navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Current page has both a semantic marker and visual highlight.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace preview\"><a href=\"#dashboard\" aria-current=\"page\">Dashboard <span>●</span></a><a href=\"#import\">Import</a></nav>",
      "css": ".ds-nav{display:grid;gap:6px;background:#111110;padding:18px;font:500 14px \"Segoe UI\",sans-serif}.ds-nav a{display:flex;justify-content:space-between;align-items:center;padding:12px;border-radius:8px;min-height:24px;color:#c1beb5;text-decoration:none;transition:background .16s,color .16s}.ds-nav a:hover{background:#20201e;color:#f1eee6}.ds-nav a[aria-current]{background:#ff6040;color:#0c0c0b;font-weight:650}.ds-nav a:focus-visible{outline:2px solid #ff947e;outline-offset:4px}"
    },
