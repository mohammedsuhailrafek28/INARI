  "narrative": {
    "northStar": "The Editorial Money Model",
    "overview": "The approved Swathi direction becomes an editorial financial interface: near-black working surfaces, warm ivory landing sections, emphatic Archivo headings, and vermilion accents. Financial screens use compact, readable controls and restrained panel boundaries; the landing page carries the larger typographic expression.\n\nThis records the implemented system, rather than a new visual proposal. The authoritative visual source is the final editorial override in client/src/index.css, together with the layout and ledger components. Earlier teal and light theme declarations in that stylesheet are compatibility history, not the current palette. Both :root and .dark receive the editorial theme.",
    "keyCharacteristics": [
      "Black working canvas and ivory editorial sections.",
      "Strong headings with quiet, legible supporting text.",
      "Flat bordered panels and explicit financial labels.",
      "Restrained motion with content visible independently of animation."
    ],
    "rules": [
      {
        "name": "The Action Pairing Rule",
        "body": "Keep white action labels on primary-dark; keep bright vermilion action fills paired with background-colored text. Do not substitute the light text accent beneath white small text.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** use the existing wv token contract for every financial feature.",
      "**Do** pair filled-action colors with their documented text colors.",
      "**Do** keep financial evidence, units, unknown values, and data-source notices visible.",
      "**Do** preserve native controls, named landmarks, focus visibility, and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** reproduce financial calculations or replace backend amounts with display fixtures.",
      "**Don't** restore the historical teal palette by copying an earlier declaration block.",
      "**Don't** hide essential content behind decorative animation.",
      "**Don't** introduce portfolio branding, property-management imagery, or external font requests."
    ]
  }
}
