  "components": [
    {
      "name": "Ledger primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Confirms an explicit ledger action; white labels require the dark fill.",
      "html": "<button class=\"ds-primary\">Confirm import</button>",
      "css": ".ds-primary{background:var(--wv-primary-dark,#b8371c);color:#fff;padding:10px 12px;border:0;border-radius:6px;font:600 14px \"Segoe UI\",sans-serif;min-height:44px;cursor:pointer;transition:background .15s}.ds-primary:hover{background:#b8371c}.ds-primary:focus-visible{outline:2px solid #ff947e;outline-offset:4px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Ghost action",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action with a structural border.",
      "html": "<button class=\"ds-ghost\">Review evidence</button>",
      "css": ".ds-ghost{background:var(--wv-surface,#161615);color:var(--wv-text,#f1eee6);border:1px solid var(--wv-border,#373733);border-radius:6px;padding:10px 12px;min-height:44px;font:500 14px \"Segoe UI\",sans-serif;cursor:pointer}.ds-ghost:hover{border-color:#ff8065}.ds-ghost:focus-visible{outline:2px solid #ff947e;outline-offset:4px}"
    },
    {
